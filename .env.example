# Скопіюйте у .env і змініть значення під своє середовище
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Якщо не задати DATABASE_URL, застосунок стартує зі сховищем у пам'яті (для демо)
DATABASE_URL=postgres://booking:booking@localhost:5432/room_booking

# ОБМ-03: домен, з якого дозволено вхід
CORPORATE_EMAIL_DOMAIN=example.com

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# НФВ-06: bcrypt cost не менше 12
BCRYPT_COST=12

# Крок планувальника, с (НФВ-07: автоскасування у вікні 10:00-10:30 після початку)
SCHEDULER_TICK_SECONDS=15

# Порожній SMTP_HOST — листи друкуються в консоль замість надсилання
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=booking@example.com
